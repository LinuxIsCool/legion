#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pillow"]
# ///
"""View an image inside kitty (also inside tmux) with smooth zoom and pan.

Keys: = or + zoom in, - zoom out, h j k l or arrows pan, 0 fit, 1 true pixels (100%),
n or > next image in the folder, p or < previous, q quit.

Each frame replaces the previous one in place (same kitty image id), so nothing flashes.
A quick frame is drawn on every key, and a sharp one once keys stop for a moment.
Keys that pile up while drawing are merged, so it cannot fall behind.
"""
import base64
import os
import select
import time
import shutil
import subprocess
import sys
import termios
import tty
from pathlib import Path

from PIL import Image

EXT = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp"}
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
TMUX = bool(os.environ.get("TMUX"))
IMAGE_ID = 4242


def out(s: str):
    sys.stdout.write(s)
    sys.stdout.flush()


def gfx(cmd: str):
    """Send a kitty graphics command, wrapped for tmux passthrough when inside tmux."""
    seq = f"\033_G{cmd}\033\\"
    if TMUX:
        seq = "\033Ptmux;" + seq.replace("\033", "\033\033") + "\033\\"
    out(seq)


def grid():
    """Rows, columns and the pixel size of the text grid, straight from the terminal."""
    import fcntl
    import struct
    rows, cols, xpix, ypix = struct.unpack("HHHH", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8))
    if not xpix:
        w, h = subprocess.run(["kitten", "icat", "--print-window-size"], capture_output=True, text=True).stdout.strip().split("x")
        xpix, ypix = int(w), int(h)
    return rows, cols, xpix, ypix


class Loader:
    """Decodes images on background threads and keeps the last few, so next/previous is instant."""

    def __init__(self):
        from concurrent.futures import ThreadPoolExecutor
        self.pool = ThreadPoolExecutor(2)
        self.jobs = {}

    @staticmethod
    def decode(path):
        im = Image.open(path).convert("RGB")
        pyramid = [(1, im)]
        while pyramid[-1][1].width > 2000:  # smaller copies keep zoomed-out views of big sheets fast
            f, img = pyramid[-1]
            pyramid.append((f * 2, img.reduce(2)))
        return im, pyramid

    def get(self, path):
        if path not in self.jobs:
            self.jobs[path] = self.pool.submit(self.decode, path)
        return self.jobs[path]

    def keep(self, paths):
        """Forget decoded images that are no longer near the current one."""
        for p in list(self.jobs):
            if p not in paths:
                self.jobs.pop(p).cancel()


class View:
    def __init__(self, files, idx):
        self.files, self.idx = files, idx
        self.frame = 0
        self.loader = Loader()
        self.resize()
        self.load()

    def resize(self):
        rows, self.cols, xpix, ypix = grid()
        self.lines = rows - 1  # last line is the status bar
        self.cw, self.ch = xpix / self.cols, ypix / rows  # pixels per cell
        self.W, self.H = xpix, int(self.ch * self.lines)
        if hasattr(self, "im"):
            self.fit = min(self.W / self.size()[0], self.H / self.size()[1])

    def load(self):
        path = self.files[self.idx]
        job = self.loader.get(path)
        if job.done():
            self.im, self.pyramid = job.result()
            self.pending = None
        else:
            # Not decoded yet: show a screen-sized decode now (JPEG draft mode is several times faster)
            # and swap in the full image when the background decode finishes.
            im = Image.open(path)
            size = im.size
            im.draft("RGB", (self.W, self.H))
            small = im.convert("RGB")
            self.im = small
            self.full_size = size
            self.pyramid = [(size[0] / small.width, small)]
            self.pending = job
        self.mtime = path.stat().st_mtime
        self.zoom, self.cx, self.cy = 1.0, 0.5, 0.5
        self.fit = min(self.W / self.size()[0], self.H / self.size()[1])
        near = {self.files[(self.idx + d) % len(self.files)] for d in (-1, 0, 1)}
        for p in near:
            self.loader.get(p)  # prefetch the neighbours
        self.loader.keep(near | {path})

    def reload_if_changed(self):
        """Show the new version when the current file is rewritten (e.g. a rebuilt gallery sheet), keeping zoom and position.
        Waits until the file has been still for a second, so a half-written image is never shown."""
        path = self.files[self.idx]
        try:
            m = path.stat().st_mtime
        except OSError:  # being replaced right now
            return False
        if m == self.mtime or time.time() - m < 1.0:
            return False
        keep = self.zoom, self.cx, self.cy
        self.loader.jobs.pop(path, None)
        try:
            self.load()
        except OSError:
            return False
        self.zoom, self.cx, self.cy = keep
        self.clamp()
        return True

    def size(self):
        return self.full_size if self.pending else self.im.size

    def poll(self):
        """Swap in the full image once its background decode is done. True if the view should redraw."""
        if self.pending and self.pending.done():
            try:
                self.im, self.pyramid = self.pending.result()
            except Exception:
                self.pending = None
                return False
            self.pending = None
            return self.zoom > 1.0
        return False

    def render(self, sharp: bool):
        iw, ih = self.size()
        scale = self.fit * self.zoom
        vw, vh = min(iw, self.W / scale), min(ih, self.H / scale)
        x0 = min(max(self.cx * iw - vw / 2, 0), iw - vw)
        y0 = min(max(self.cy * ih - vh / 2, 0), ih - vh)
        f, src = next(((f, img) for f, img in reversed(self.pyramid) if scale * f <= 1.0), self.pyramid[0])
        crop = src.crop((int(x0 / f), int(y0 / f), int((x0 + vw) / f), int((y0 + vh) / f)))
        size = (max(1, min(self.W, round(crop.width * scale * f))), max(1, min(self.H, round(crop.height * scale * f))))
        method = Image.NEAREST if scale >= 2 else (Image.LANCZOS if sharp else Image.BILINEAR)
        frame = crop.resize(size, method)
        # Raw pixels through a RAM file, sent straight to kitty with a fixed image id:
        # the new frame replaces the old one in place, with no helper process and nothing to clear.
        self.frame ^= 1
        path = RUN / f"imgt-{os.getpid()}-{self.frame}.rgb"
        path.write_bytes(frame.tobytes())
        left, top = (self.W - frame.width) / 2, (self.H - frame.height) / 2
        col, row = int(left // self.cw), int(top // self.ch)
        X, Y = int(left - col * self.cw), int(top - row * self.ch)
        b64 = base64.b64encode(str(path).encode()).decode()
        out(f"\033[{row + 1};{col + 1}H")
        gfx(f"a=T,f=24,t=f,s={frame.width},v={frame.height},i={IMAGE_ID},p=1,X={X},Y={Y},C=1,q=2;{b64}")
        name = self.files[self.idx].name
        status = (f"{name}  {self.idx + 1}/{len(self.files)}  zoom {scale * 100:.0f}%   "
                  "= - zoom  hjkl pan  0 fit  1 100%  n p next/prev  q quit")
        out(f"\033[{self.lines + 1};1H\033[2K\033[2m{status[:self.cols - 1]}\033[0m")

    def step(self, d):
        """Next or previous image. Re-read the folder first, so files added or deleted meanwhile are handled."""
        cur = self.files[self.idx]
        files = sorted(p for p in cur.parent.iterdir() if p.suffix.lower() in EXT) or [cur]
        names = [f.name for f in files]
        # position of the current file, or where it would sit if it was deleted
        here = names.index(cur.name) if cur.name in names else sum(n < cur.name for n in names) - (1 if d > 0 else 0)
        self.files, self.idx = files, (here + d) % len(files)
        try:
            self.load()
        except OSError:  # unreadable or vanished: skip it
            if len(files) > 1:
                self.step(d)

    def view(self):
        """Visible part of the image, as fractions of its width and height."""
        scale, (iw, ih) = self.fit * self.zoom, self.size()
        return min(1.0, self.W / scale / iw), min(1.0, self.H / scale / ih)

    def clamp(self):
        # Keep the centre where the view can actually be, so every pan press moves the picture.
        fw, fh = self.view()
        self.cx = min(max(self.cx, fw / 2), 1 - fw / 2)
        self.cy = min(max(self.cy, fh / 2), 1 - fh / 2)

    def apply(self, k):
        fw, fh = self.view()
        if k in "=+":
            self.zoom = min(self.zoom * 1.25, 64)
        elif k == "-":
            self.zoom = max(self.zoom / 1.25, 1)
        elif k == "h":
            self.cx -= fw * 0.15
        elif k == "l":
            self.cx += fw * 0.15
        elif k == "k":
            self.cy -= fh * 0.15
        elif k == "j":
            self.cy += fh * 0.15
        elif k == "0":
            self.zoom, self.cx, self.cy = 1.0, 0.5, 0.5
        elif k == "1":
            self.zoom = max(1.0, 1 / self.fit)
        elif k in "n>p<":
            self.step(1 if k in "n>" else -1)
        self.clamp()


def read_keys(fd, timeout):
    """Wait up to timeout for input; return every key already waiting (arrows mapped to hjkl)."""
    if not select.select([fd], [], [], timeout)[0]:
        return None
    data = os.read(fd, 1024)
    while select.select([fd], [], [], 0)[0]:
        data += os.read(fd, 1024)
    keys, i = [], 0
    while i < len(data):
        if data[i:i + 2] == b"\x1b[" and i + 2 < len(data):
            keys.append({65: "k", 66: "j", 67: "l", 68: "h"}.get(data[i + 2], ""))
            i += 3
        else:
            keys.append(chr(data[i]))
            i += 1
    return keys


RESIZED = False


def on_resize(*_):
    global RESIZED
    RESIZED = True


def main():
    path = Path(sys.argv[1]).resolve()
    if TMUX:
        # tmux repaints cut bands into kitty pictures, so view in a new kitty window outside tmux (Hyprland tiles it as a split) and wait for it.
        env = {k: v for k, v in os.environ.items() if k not in ("TMUX", "TMUX_PANE")}
        # Remember the window and tmux pane that launched us, to give focus back when the viewer closes.
        import json
        home = None
        try:
            win = json.loads(subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True).stdout)
            home = win["address"]
            # Dispatches use Hyprland's Lua syntax (hl.dsp.*). Dwindle splits the focused window along its long side, which stacks a tall window's viewer in the
            # same column. Preselect a side-by-side split instead, toward the side of the screen with more room.
            # Viewers share one column: if one is already open on this workspace, stack the new one under the lowest.
            clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout)
            viewers = [c for c in clients if c["class"] == "imgt" and c["workspace"]["id"] == win["workspace"]["id"]]
            if viewers:
                lowest = max(viewers, key=lambda c: c["at"][1])
                subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{window="address:{lowest["address"]}"}})'], capture_output=True)
                side = "d"
            else:
                mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout)
                mon = next(m for m in mons if m["id"] == win["monitor"])
                centre = win["at"][0] + win["size"][0] / 2 - mon["x"]
                side = "l" if centre > mon["width"] / mon["scale"] / 2 else "r"
            subprocess.run(["hyprctl", "dispatch", f'hl.dsp.layout("preselect {side}")'], capture_output=True)
        except Exception:
            pass
        pane = os.environ.get("TMUX_PANE")
        child = subprocess.Popen(["kitty", "--class=imgt", "-o", "confirm_os_window_close=0", sys.argv[0], str(path)], env=env)
        try:
            child.wait()
        except KeyboardInterrupt:  # Ctrl-C here closes the image window quietly
            child.terminate()
            child.wait()
        if home:
            subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{window="address:{home}"}})'], capture_output=True)
        if pane:
            subprocess.run(["tmux", "select-window", "-t", pane], capture_output=True)
            subprocess.run(["tmux", "select-pane", "-t", pane], capture_output=True)
        return
    files = sorted(p for p in path.parent.iterdir() if p.suffix.lower() in EXT)
    idx = files.index(path) if path in files else 0
    zoomed = "1"
    if TMUX:
        zoomed = subprocess.run(["tmux", "display", "-p", "#{window_zoomed_flag}"], capture_output=True, text=True).stdout.strip()
        if zoomed == "0":
            subprocess.run(["tmux", "resize-pane", "-Z"])
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    out("\033[?25l\033[?7l\033[2J")  # hide cursor, no line wrap
    try:
        import signal
        global RESIZED
        signal.signal(signal.SIGWINCH, on_resize)
        v = View(files, idx)
        v.render(sharp=True)
        dirty = False
        checked = time.monotonic()
        while True:
            try:
                keys = read_keys(fd, 0.12 if dirty else 0.25)
            except KeyboardInterrupt:  # Ctrl-C quits cleanly, like q
                return
            if RESIZED:
                RESIZED = False
                v.resize()
                out("\033[2J")
                v.fit = min(v.W / v.size()[0], v.H / v.size()[1])
                v.render(sharp=True)
                continue
            if v.poll():
                v.render(sharp=True)
            if keys is None:  # keys stopped: draw the sharp frame once
                if dirty:
                    v.render(sharp=True)
                    dirty = False
                elif time.monotonic() - checked > 1.0:  # idle: pick up a rewritten file
                    checked = time.monotonic()
                    if v.reload_if_changed():
                        v.render(sharp=True)
                continue
            if "q" in keys:
                return
            for k in keys:
                v.apply(k)
            v.render(sharp=False)
            dirty = True
    finally:
        # Swallow any terminal replies still in flight, so none leak out as keystrokes after we exit.
        while select.select([fd], [], [], 0.05)[0]:
            os.read(fd, 4096)
        termios.tcsetattr(fd, termios.TCSAFLUSH, old)
        gfx(f"a=d,d=I,i={IMAGE_ID},q=2")
        out("\033[2J\033[H\033[?7h\033[?25h")
        for f in RUN.glob(f"imgt-{os.getpid()}-*.rgb"):
            f.unlink(missing_ok=True)
        if zoomed == "0":
            subprocess.run(["tmux", "resize-pane", "-Z"])


if __name__ == "__main__":
    main()
